  <div class="toast" id="toast" role="status" aria-live="polite">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg>
    <span id="toast-msg"></span>
  </div>

  <script>
    (function () {
      'use strict';
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function $(s, r) { return (r || document).querySelector(s); }
      function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

      /* ---------- Toast ---------- */
      var toastEl = $('#toast'), toastMsg = $('#toast-msg'), toastTimer;
      function toast(msg) {
        toastMsg.textContent = msg;
        toastEl.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
      }

      /* ---------- Theme toggle ---------- */
      $('#theme-toggle').addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      /* ---------- Navbar: scroll state, dropdowns, mobile menu, "/" shortcut ---------- */
      var nav = $('#nav');
      function onScroll() { nav.classList.toggle('scrolled', window.scrollY > 8); }
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

      var dds = document.querySelectorAll('.dd');
      function closeDropdowns(except) {
        dds.forEach(function (d) {
          if (d !== except) { d.classList.remove('open'); d.querySelector('.dd-toggle').setAttribute('aria-expanded', 'false'); }
        });
      }
      dds.forEach(function (d) {
        var btn = d.querySelector('.dd-toggle');
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = !d.classList.contains('open');
          closeDropdowns(d);
          d.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', function () { closeDropdowns(); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDropdowns();
        var tag = (document.activeElement || {}).tagName;
        if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') {
          var s = $('#nav-search');
          if (s && s.offsetParent !== null) { e.preventDefault(); s.focus(); }
        }
      });

      var burger = $('#burger'), panel = $('#mobile-panel');
      burger.addEventListener('click', function () {
        var open = panel.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(open));
      });

      /* ---------- Contribution heatmap ---------- */
      (function heatmap() {
        var grid = $('#heat-grid'), tip = $('#heat-tip'), wrap = grid.parentElement;
        var ROWS = 7, cols = 0, cells = [], lit = [], raf = 0;
        var seed = 11;
        function rnd() { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; }
        var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function build() {
          var c = window.innerWidth < 700 ? 24 : window.innerWidth < 1100 ? 40 : 53;
          if (c === cols) return;
          cols = c; seed = 11; grid.innerHTML = ''; cells = []; lit = [];
          grid.style.gridTemplateColumns = 'repeat(' + cols + ', minmax(0, 1fr))';
          var total = cols * ROWS, now = Date.now();
          for (var i = 0; i < total; i++) {
            var col = Math.floor(i / ROWS), row = i % ROWS;
            var r = rnd();
            var base = r < .34 ? 0 : r < .6 ? 1 : r < .8 ? 2 : r < .93 ? 3 : 4;
            var d = new Date(now - (total - 1 - i) * 864e5);
            var el = document.createElement('span');
            el.className = 'cell'; el.dataset.level = '0';
            grid.appendChild(el);
            cells.push({ el: el, col: col, row: row, base: base, count: base === 0 ? 0 : base * 2 + Math.floor(rnd() * 4), label: months[d.getMonth()] + ' ' + d.getDate() });
          }
          // Load animation: a single wave from left to right
          cells.forEach(function (c) {
            if (reduceMotion) { c.el.dataset.level = c.base; return; }
            setTimeout(function () { c.el.dataset.level = c.base; }, 350 + c.col * 24 + c.row * 12);
          });
        }

        function reset() {
          lit.forEach(function (c) { c.el.dataset.level = c.base; c.el.style.transform = ''; });
          lit = [];
        }
        function glow(col, row) {
          reset();
          for (var dx = -3; dx <= 3; dx++) for (var dy = -3; dy <= 3; dy++) {
            var dist = Math.hypot(dx, dy);
            var cc = col + dx, rr = row + dy;
            if (dist > 3 || cc < 0 || cc >= cols || rr < 0 || rr >= ROWS) continue;
            var c = cells[cc * ROWS + rr];
            c.el.dataset.level = Math.min(4, c.base + Math.round(3.4 - dist));
            c.el.style.transform = 'scale(' + (1 + (3 - dist) * 0.08).toFixed(2) + ')';
            lit.push(c);
          }
        }
        grid.addEventListener('pointermove', function (e) {
          if (reduceMotion || raf) return;
          raf = requestAnimationFrame(function () {
            raf = 0;
            var rect = grid.getBoundingClientRect();
            var cw = rect.width / cols, ch = rect.height / ROWS;
            var col = Math.floor((e.clientX - rect.left) / cw), row = Math.floor((e.clientY - rect.top) / ch);
            if (col < 0 || col >= cols || row < 0 || row >= ROWS) return;
            glow(col, row);
            var c = cells[col * ROWS + row];
            tip.hidden = false;
            tip.textContent = (c.count === 0 ? 'No contributions' : c.count + ' contributions') + ' on ' + c.label;
            var wr = wrap.getBoundingClientRect();
            tip.style.left = Math.min(Math.max(rect.left - wr.left + (col + .5) * cw, 80), wr.width - 80) + 'px';
            tip.style.top = (rect.top - wr.top + row * ch - 10) + 'px';
          });
        });
        grid.addEventListener('pointerleave', function () { reset(); tip.hidden = true; });
        var t; window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(build, 150); });
        build();
      })();

      /* ---------- Issue finder ---------- */
      // Replace ISSUES with: fetch('/api/issues?label=good-first-issue').then(r => r.json())
      var ISSUES = [
        { id: 1, title: 'Fix broken anchor links in the contributing guide', repo: 'lumen-ui/handbook', num: 412, lang: 'Docs', color: '#8b949e', labels: ['good first issue', 'docs'], comments: 3, age: '2 hours ago' },
        { id: 2, title: 'Add keyboard navigation to the dropdown component', repo: 'lumen-ui/lumen', num: 1089, lang: 'JavaScript', color: '#f1e05a', labels: ['good first issue', 'a11y'], comments: 5, age: '5 hours ago' },
        { id: 3, title: 'Handle empty CSV files without raising IndexError', repo: 'tabular-py/tabular', num: 233, lang: 'Python', color: '#3572A5', labels: ['good first issue', 'bug'], comments: 2, age: 'yesterday' },
        { id: 4, title: 'Return a clear error when the config path is missing', repo: 'gopher-cli/gcli', num: 78, lang: 'Go', color: '#00ADD8', labels: ['good first issue', 'cli'], comments: 1, age: 'yesterday' },
        { id: 5, title: 'Write unit tests for the retry backoff helper', repo: 'lumen-ui/lumen', num: 1102, lang: 'JavaScript', color: '#f1e05a', labels: ['good first issue', 'tests'], comments: 0, age: '2 days ago' },
        { id: 6, title: 'Document the environment variables in the README', repo: 'pipeline-rs/forge', num: 61, lang: 'Docs', color: '#8b949e', labels: ['good first issue', 'docs'], comments: 4, age: '2 days ago' },
        { id: 7, title: 'Replace deprecated string API in the tokenizer', repo: 'pipeline-rs/forge', num: 57, lang: 'Rust', color: '#dea584', labels: ['good first issue', 'refactor'], comments: 2, age: '3 days ago' },
        { id: 8, title: 'Support type hints in the plugin loader', repo: 'tabular-py/tabular', num: 241, lang: 'Python', color: '#3572A5', labels: ['good first issue', 'typing'], comments: 6, age: '4 days ago' }
      ];
      var LANGS = ['All', 'JavaScript', 'Python', 'Go', 'Rust', 'Docs'];
      var state = { lang: 'All', q: '' }, claimed = {};
      var listEl = $('#issue-list'), countEl = $('#issue-count'), chipsEl = $('#chips');

      chipsEl.innerHTML = LANGS.map(function (l) {
        return '<button class="chip" type="button" data-lang="' + l + '" aria-pressed="' + (l === 'All') + '">' + l + '</button>';
      }).join('');

      function renderIssues() {
        var q = state.q.trim().toLowerCase();
        var items = ISSUES.filter(function (it) {
          return (state.lang === 'All' || it.lang === state.lang) &&
                 (!q || (it.title + ' ' + it.repo + ' ' + it.labels.join(' ')).toLowerCase().indexOf(q) > -1);
        }).slice(0, 5);
        countEl.textContent = items.length + ' shown';
        if (!items.length) {
          listEl.innerHTML = '<li class="empty"><strong>No issues match these filters</strong>Try another language or clear the keyword.</li>';
          return;
        }
        listEl.innerHTML = items.map(function (it, i) {
          var done = !!claimed[it.id];
          return '<li class="issue" style="--i:' + i + '">' +
            '<svg class="state" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.2"/><circle cx="8" cy="8" r="1.4" fill="currentColor"/></svg>' +
            '<div class="body"><div class="t">' + esc(it.title) + '</div>' +
            '<div class="meta"><span>' + esc(it.repo) + ' #' + it.num + '</span>' +
            '<span class="label gfi">' + esc(it.labels[0]) + '</span><span class="label tag">' + esc(it.labels[1]) + '</span>' +
            '<span><span class="dot" style="background:' + it.color + '"></span>' + esc(it.lang) + '</span>' +
            '<span>' + it.comments + ' comments</span><span>' + esc(it.age) + '</span></div></div>' +
            '<button class="btn claim' + (done ? ' done' : '') + '" type="button" data-id="' + it.id + '" aria-pressed="' + done + '">' + (done ? 'Claimed' : 'Claim') + '</button>' +
            '</li>';
        }).join('');
      }

      chipsEl.addEventListener('click', function (e) {
        var b = e.target.closest('.chip'); if (!b) return;
        state.lang = b.dataset.lang;
        chipsEl.querySelectorAll('.chip').forEach(function (c) { c.setAttribute('aria-pressed', String(c === b)); });
        renderIssues();
      });
      $('#issue-q').addEventListener('input', function (e) { state.q = e.target.value; renderIssues(); });
      listEl.addEventListener('click', function (e) {
        var b = e.target.closest('.claim'); if (!b) return;
        var id = b.dataset.id, it = ISSUES.filter(function (x) { return String(x.id) === id; })[0];
        claimed[id] = !claimed[id];
        b.classList.toggle('done', claimed[id]);
        b.textContent = claimed[id] ? 'Claimed' : 'Claim';
        b.setAttribute('aria-pressed', String(claimed[id]));
        // Wire this to your API: fetch('/api/issues/' + id + '/claim', { method: 'POST' })
        toast(claimed[id] ? 'Issue claimed. The maintainer of ' + it.repo.split('/')[0] + ' has been notified.' : 'Claim removed.');
      });
      renderIssues();

      /* ---------- Animated counters ---------- */
      var counters = document.querySelectorAll('[data-count]');
      function runCounter(el) {
        var target = +el.dataset.count, suffix = el.dataset.suffix || '', dur = 1400, start = null;
        if (reduceMotion) { el.textContent = target.toLocaleString() + suffix; return; }
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min((ts - start) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased).toLocaleString() + (p === 1 ? suffix : '');
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { runCounter(en.target); io.unobserve(en.target); } });
        }, { threshold: .6 });
        counters.forEach(function (c) { io.observe(c); });
      } else { counters.forEach(runCounter); }

      /* ---------- Steps + terminal ---------- */
      var STEPS = [
        { title: 'terminal: clone', lines: [
          ['cmd', 'git clone https://github.com/you/lumen.git'], ['out', "Cloning into 'lumen'..."],
          ['cmd', 'cd lumen && npm install'], ['out', 'added 214 packages in 9s'], ['ok', 'Ready to work on issue #1089']
        ] },
        { title: 'terminal: claim', lines: [
          ['cmd', 'git checkout -b fix/dropdown-keyboard-nav'], ['out', "Switched to a new branch 'fix/dropdown-keyboard-nav'"],
          ['cmd', 'npm test -- dropdown'], ['ok', 'Tests: 4 failing, waiting for your fix']
        ] },
        { title: 'terminal: pull request', lines: [
          ['cmd', 'git add . && git commit -m "feat: keyboard nav for dropdown"'], ['out', '[fix/dropdown-keyboard-nav 3f9a1c2] feat: keyboard nav for dropdown'],
          ['cmd', 'git push origin fix/dropdown-keyboard-nav'], ['out', "remote: Create a pull request for 'fix/dropdown-keyboard-nav'"],
          ['ok', 'Pull request opened. Review requested.']
        ] }
      ];
      var termBody = $('#term-body'), termTitle = $('#term-title'), tabs = document.querySelectorAll('.step-tab');
      function showStep(i) {
        var s = STEPS[i];
        termTitle.textContent = s.title;
        termBody.innerHTML = s.lines.map(function (l, n) {
          return '<div class="term-line ' + l[0] + '" style="--i:' + n + '">' + esc(l[1]) + '</div>';
        }).join('') + '<div class="term-line" style="--i:' + s.lines.length + '"><span class="caret"></span></div>';
        tabs.forEach(function (t, n) { t.setAttribute('aria-selected', String(n === i)); });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { showStep(+t.dataset.step); }); });
      showStep(0);

      /* ---------- Featured projects ---------- */
      // Replace with data from your Express API (e.g. res.render('landing', { projects }))
      var PROJECTS = [
        { name: 'lumen-ui/lumen', desc: 'Accessible React component library with a focus on keyboard and screen reader support.', lang: 'JavaScript', color: '#f1e05a', stars: 8421, gfi: 14 },
        { name: 'tabular-py/tabular', desc: 'Fast, friendly toolkit for cleaning and reshaping messy tabular data.', lang: 'Python', color: '#3572A5', stars: 5310, gfi: 9 },
        { name: 'gopher-cli/gcli', desc: 'A small framework for building command line tools with sensible defaults.', lang: 'Go', color: '#00ADD8', stars: 3987, gfi: 6 },
        { name: 'pipeline-rs/forge', desc: 'Build pipeline runner written in Rust with reproducible caching.', lang: 'Rust', color: '#dea584', stars: 6752, gfi: 11 },
        { name: 'lumen-ui/handbook', desc: 'Guides, recipes, and contributor docs for the Lumen ecosystem.', lang: 'Markdown', color: '#8b949e', stars: 1290, gfi: 21 },
        { name: 'mapkit-js/mapkit', desc: 'Lightweight mapping helpers for the browser, no API keys required.', lang: 'TypeScript', color: '#3178c6', stars: 4156, gfi: 8 }
      ];
      var pg = $('#project-grid');
      pg.innerHTML = PROJECTS.map(function (p, i) {
        return '<article class="card">' +
          '<div class="card-top"><a class="repo" href="/projects/' + esc(p.name) + '"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 12.5V3.5A1.5 1.5 0 0 1 4.5 2H13v10H4.5A1.5 1.5 0 0 0 3 13.5 1.5 1.5 0 0 0 4.5 15H13"/></svg><span>' + esc(p.name) + '</span></a>' +
          '<button class="star" type="button" data-i="' + i + '" aria-pressed="false" aria-label="Star ' + esc(p.name) + '"><svg width="14" height="14" viewBox="0 0 16 16" stroke-linejoin="round" aria-hidden="true"><polygon points="8,1 10,6 15.5,6.5 11.3,10 12.7,15.3 8,12.3 3.3,15.3 4.7,10 .5,6.5 6,6"/></svg><span>' + p.stars.toLocaleString() + '</span></button></div>' +
          '<p>' + esc(p.desc) + '</p>' +
          '<div class="card-foot"><span><span class="dot" style="background:' + p.color + '"></span>' + esc(p.lang) + '</span><span class="gfi-count">' + p.gfi + ' good first issues</span></div>' +
          '</article>';
      }).join('');
      pg.addEventListener('click', function (e) {
        var b = e.target.closest('.star'); if (!b) return;
        var p = PROJECTS[+b.dataset.i], on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        b.querySelector('span').textContent = (p.stars + (on ? 1 : 0)).toLocaleString();
        // Wire this to your API: fetch('/api/projects/star', { method: 'POST', ... })
      });
    })();
  </script>
</body>
</html>
