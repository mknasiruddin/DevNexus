    <!-- ======================= HOW IT WORKS ======================= -->
    <section class="block" id="how">
      <div class="container">
        <div class="sec-head">
          <div>
            <h2>From browsing to merged in three steps</h2>
            <p>You do not need to know a codebase to start. Pick a task that is scoped for newcomers and the project explains the rest.</p>
          </div>
        </div>
        <div class="steps">
          <div class="step-tabs" role="tablist" aria-label="Contribution steps" id="step-tabs">
            <button class="step-tab" role="tab" aria-selected="true" data-step="0">
              <span class="step-num">1</span>
              <span><h3>Pick a project</h3><p>Filter by language, topic, or difficulty.</p>
                <span class="extra"><p>Every listed project has a contributing guide and at least one open beginner issue.</p></span></span>
            </button>
            <button class="step-tab" role="tab" aria-selected="false" data-step="1">
              <span class="step-num">2</span>
              <span><h3>Claim an issue</h3><p>Let the maintainer know you are on it.</p>
                <span class="extra"><p>Press Claim on any issue and the maintainer is notified, so nobody duplicates your work.</p></span></span>
            </button>
            <button class="step-tab" role="tab" aria-selected="false" data-step="2">
              <span class="step-num">3</span>
              <span><h3>Open a pull request</h3><p>Push your branch and ask for review.</p>
