<%
  /* ------------------------------------------------------------------
     Optional locals you can pass from Express (all have defaults):
       res.render('landing', {
         siteName: 'DevNexus',
         user: req.user || null,          // logged-in user shows "Dashboard" instead of Sign in
         routes: { signup: '/signup' },   // override any link below
         stats: { projects: 2400, contributors: 18500, merged: 96000 }
       });
  ------------------------------------------------------------------- */
  const siteName = locals.siteName || 'DevNexus';
  const user = locals.user || null;
  const routes = Object.assign({
    home: '/', projects: '/projects', issues: '/issues', topics: '/topics',
    guide: '/learn', git: '/learn/git-basics', conduct: '/learn/code-of-conduct',
    leaderboard: '/leaderboard', maintainers: '/maintainers', events: '/events',
    login: '/login', signup: '/signup', dashboard: '/dashboard', search: '/search',
    about: '/about', docs: '/docs', privacy: '/privacy', terms: '/terms'
  }, locals.routes || {});
  const stats = Object.assign({ projects: 2400, contributors: 18500, merged: 96000 }, locals.stats || {});
%>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= siteName %> | Find open source projects and make your first contribution</title>
  <meta name="description" content="Browse open source projects that welcome new contributors, claim a beginner-friendly issue, and open your first pull request.">
  <script>
    // Set theme before first paint to avoid a flash
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <style>
    :root {
      --bg: #0d1117;
      --surface: #161b22;
      --surface-2: #1c2128;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
      --accent: #238636;
      --accent-hover: #2ea043;
      --accent-text: #3fb950;
      --link: #58a6ff;
      --shadow: 0 12px 32px rgba(1, 4, 9, .6);
      --l0: #161b22; --l1: #0e4429; --l2: #006d32; --l3: #26a641; --l4: #39d353;
      --cell-edge: rgba(240, 246, 252, .06);
      --font: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
      --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    }
    [data-theme="light"] {
      --bg: #ffffff;
      --surface: #f6f8fa;
      --surface-2: #eaeef2;
      --border: #d0d7de;
      --text: #1f2328;
      --muted: #59636e;
      --accent: #1f883d;
      --accent-hover: #1a7f37;
      --accent-text: #1a7f37;
      --link: #0969da;
      --shadow: 0 12px 32px rgba(140, 149, 159, .3);
      --l0: #ebedf0; --l1: #9be9a8; --l2: #40c463; --l3: #30a14e; --l4: #216e39;
      --cell-edge: rgba(31, 35, 40, .06);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font-family: var(--font); font-size: 16px; line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      transition: background .25s, color .25s;
    }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; cursor: pointer; }
    svg { display: block; flex-shrink: 0; }
    :focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: 6px; }
    .container { width: min(1200px, 100% - 48px); margin-inline: auto; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .skip { position: absolute; left: 12px; top: -60px; background: var(--accent); color: #fff; padding: 8px 14px; border-radius: 6px; z-index: 200; }
    .skip:focus { top: 12px; }

    /* ---------- Buttons ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 8px 16px; border-radius: 6px; border: 1px solid var(--border);
      background: var(--surface); font-weight: 600; font-size: 14px; line-height: 20px;
      transition: background .15s, border-color .15s, transform .15s, box-shadow .15s;
      white-space: nowrap;
    }
    .btn:hover { background: var(--surface-2); border-color: var(--muted); }
    .btn:active { transform: translateY(1px); }
    .btn-primary { background: var(--accent); border-color: rgba(240, 246, 252, .1); color: #fff; }
    .btn-primary:hover { background: var(--accent-hover); border-color: rgba(240, 246, 252, .2); box-shadow: 0 0 0 4px rgba(46, 160, 67, .2); }
    .btn-lg { padding: 12px 22px; font-size: 16px; line-height: 24px; border-radius: 8px; }
    .btn .arrow { transition: transform .2s; }
    .btn:hover .arrow { transform: translateX(3px); }

    /* ---------- Navbar ---------- */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid transparent;
      transition: border-color .2s, box-shadow .2s;
    }
    .nav.scrolled { border-color: var(--border); box-shadow: 0 1px 0 rgba(0,0,0,.1); }
    .nav-inner { display: flex; align-items: center; gap: 16px; height: 68px; }
    .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; letter-spacing: -.01em; margin-right: 8px; }
    .logo svg { color: var(--accent-text); transition: transform .5s cubic-bezier(.3, 1.6, .5, 1); }
    .logo:hover svg { transform: rotate(180deg); }
    .nav-links { display: flex; align-items: center; gap: 2px; }
    .nav-link {
      display: inline-flex; align-items: center; gap: 4px; padding: 8px 12px; border-radius: 6px;
      background: none; border: 0; font-size: 15px; font-weight: 500; color: var(--text);
      transition: background .15s, color .15s;
    }
    .nav-link:hover, .dd.open > .nav-link { background: var(--surface); }
    .nav-link .chev { transition: transform .2s; color: var(--muted); }
    .dd { position: relative; }
    .dd.open .chev { transform: rotate(180deg); }
    .dd-menu {
      position: absolute; top: calc(100% + 8px); left: 0; min-width: 280px; padding: 8px;
      background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow);
      opacity: 0; visibility: hidden; transform: translateY(-6px) scale(.98); transform-origin: top left;
      transition: opacity .18s, transform .18s, visibility .18s;
    }
    .dd.open .dd-menu { opacity: 1; visibility: visible; transform: none; }
    .dd-menu a { display: block; padding: 10px 12px; border-radius: 8px; transition: background .15s; }
    .dd-menu a:hover { background: var(--surface-2); }
    .dd-menu strong { display: block; font-size: 14px; }
    .dd-menu span { display: block; font-size: 13px; color: var(--muted); }

    .nav-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .search {
      position: relative; display: flex; align-items: center; width: 240px;
      transition: width .25s cubic-bezier(.3, .8, .3, 1);
    }
    .search:focus-within { width: 340px; }
    .search svg { position: absolute; left: 10px; color: var(--muted); pointer-events: none; }
    .search input {
      width: 100%; height: 34px; padding: 0 34px 0 34px; font: inherit; font-size: 14px;
      background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; outline: none;
      transition: border-color .15s, box-shadow .15s;
    }
    .search input::placeholder { color: var(--muted); }
    .search input:focus { border-color: var(--link); box-shadow: 0 0 0 3px color-mix(in srgb, var(--link) 25%, transparent); }
    .kbd {
      position: absolute; right: 8px; font: 12px var(--mono); color: var(--muted);
      border: 1px solid var(--border); border-radius: 4px; padding: 0 6px; line-height: 18px; pointer-events: none;
    }
    .search input:focus ~ .kbd { opacity: 0; }
    .icon-btn {
      width: 36px; height: 36px; display: grid; place-items: center; border-radius: 6px;
      background: none; border: 1px solid var(--border); transition: background .15s;
    }
    .icon-btn:hover { background: var(--surface); }
    .theme-sun { display: block; } .theme-moon { display: none; }
    [data-theme="light"] .theme-sun { display: none; } [data-theme="light"] .theme-moon { display: block; }
    .signin { font-size: 14px; font-weight: 600; padding: 8px 10px; border-radius: 6px; }
    .signin:hover { color: var(--muted); }
    .burger { display: none; }

    .mobile-panel {
      display: none; border-top: 1px solid var(--border); background: var(--bg);
      max-height: 0; overflow: hidden; transition: max-height .3s ease;
    }
    .mobile-panel.open { max-height: 520px; }
    .mobile-panel .inner { padding: 12px 0 20px; display: grid; gap: 2px; }
    .mobile-panel a.m-link { padding: 12px 8px; border-bottom: 1px solid var(--border); font-weight: 500; }
    .mobile-panel .m-actions { display: flex; gap: 10px; padding-top: 16px; }
    .mobile-panel .m-actions .btn { flex: 1; }

    /* ---------- Hero ---------- */
    .hero { padding: 72px 0 40px; }
    .hero-grid { display: grid; grid-template-columns: 1fr 1.02fr; gap: 56px; align-items: center; }
    .hero h1 {
      margin: 0 0 20px; font-size: clamp(2.5rem, 5.4vw, 4.1rem); line-height: 1.06;
      letter-spacing: -.035em; font-weight: 800; text-wrap: balance;
    }
    .hero p.lead { margin: 0 0 32px; font-size: 20px; color: var(--muted); max-width: 46ch; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
    .hero-note { margin-top: 20px; font-size: 14px; color: var(--muted); }
    .hero-load { animation: rise .7s cubic-bezier(.2, .8, .2, 1) both; }
    .hero-load:nth-child(2) { animation-delay: .08s; }
    .hero-load:nth-child(3) { animation-delay: .16s; }
    .hero-load:nth-child(4) { animation-delay: .24s; }
    @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

    /* Issue finder card */
    .finder {
      background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
      box-shadow: var(--shadow); overflow: hidden; animation: rise .8s .2s cubic-bezier(.2, .8, .2, 1) both;
    }
    .finder-head { padding: 16px 16px 12px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
    .finder-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; font-weight: 600; font-size: 14px; }
    .finder-title .count { color: var(--muted); font-weight: 500; }
    .finder-search { position: relative; margin-bottom: 12px; }
    .finder-search svg { position: absolute; left: 10px; top: 9px; color: var(--muted); }
    .finder-search input {
      width: 100%; height: 34px; padding: 0 10px 0 34px; font: inherit; font-size: 14px;
      background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; outline: none;
    }
    .finder-search input:focus { border-color: var(--link); box-shadow: 0 0 0 3px color-mix(in srgb, var(--link) 25%, transparent); }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip {
      padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 500;
      background: transparent; border: 1px solid var(--border); color: var(--muted);
      transition: background .15s, color .15s, border-color .15s;
    }
    .chip:hover { color: var(--text); border-color: var(--muted); }
    .chip[aria-pressed="true"] { background: var(--link); border-color: var(--link); color: #fff; }
    .issue-list { list-style: none; margin: 0; padding: 0; min-height: 340px; }
    .issue {
      display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-bottom: 1px solid var(--border);
      animation: rowIn .35s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 45ms);
      transition: background .15s;
    }
    .issue:last-child { border-bottom: 0; }
    .issue:hover { background: color-mix(in srgb, var(--surface-2) 70%, transparent); }
    @keyframes rowIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
    .issue .state { color: var(--accent-text); margin-top: 3px; }
    .issue .body { flex: 1; min-width: 0; }
    .issue .t { font-weight: 600; font-size: 15px; line-height: 1.35; }
    .issue .meta { margin-top: 4px; font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
    .label { font-size: 12px; font-weight: 500; padding: 0 8px; border-radius: 999px; line-height: 20px; border: 1px solid transparent; }
    .label.gfi { color: var(--accent-text); border-color: color-mix(in srgb, var(--accent-text) 40%, transparent); background: color-mix(in srgb, var(--accent-text) 12%, transparent); }
    .label.tag { color: var(--link); border-color: color-mix(in srgb, var(--link) 40%, transparent); background: color-mix(in srgb, var(--link) 12%, transparent); }
    .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }
    .claim { padding: 3px 12px; font-size: 13px; border-radius: 6px; }
    .claim.done { background: color-mix(in srgb, var(--accent-text) 16%, transparent); border-color: color-mix(in srgb, var(--accent-text) 50%, transparent); color: var(--accent-text); }
    .empty { padding: 56px 24px; text-align: center; color: var(--muted); }
    .empty strong { display: block; color: var(--text); margin-bottom: 4px; }

    /* Contribution heatmap */
    .heat { position: relative; margin-top: 56px; }
    .heat-caption { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; font-size: 14px; color: var(--muted); }
    .heat-caption strong { color: var(--text); font-weight: 600; }
    .heat-grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, auto); gap: 4px; touch-action: pan-y; }
    .cell { aspect-ratio: 1; border-radius: 3px; background: var(--l0); box-shadow: inset 0 0 0 1px var(--cell-edge); transition: background .35s, transform .18s; }
    .cell[data-level="1"] { background: var(--l1); }
    .cell[data-level="2"] { background: var(--l2); }
    .cell[data-level="3"] { background: var(--l3); }
    .cell[data-level="4"] { background: var(--l4); }
    .heat-tip {
      position: absolute; z-index: 5; transform: translate(-50%, -100%); pointer-events: none;
      background: var(--text); color: var(--bg); font-size: 12px; font-weight: 500; padding: 5px 9px; border-radius: 6px; white-space: nowrap;
    }
    .heat-tip[hidden] { display: none; }

    /* ---------- Stats ---------- */
    .stats { padding: 40px 0 8px; }
    .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
    .stat { padding: 28px 32px; }
    .stat + .stat { border-left: 1px solid var(--border); }
    .stat .n { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .stat .l { color: var(--muted); font-size: 15px; margin-top: 4px; }

    /* ---------- Sections ---------- */
    section.block { padding: 96px 0 0; }
    .sec-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
    .sec-head h2 { margin: 0; font-size: clamp(1.7rem, 3.2vw, 2.4rem); letter-spacing: -.025em; line-height: 1.15; text-wrap: balance; }
    .sec-head p { margin: 8px 0 0; color: var(--muted); font-size: 17px; max-width: 56ch; }
    .link { color: var(--link); font-weight: 500; }
    .link:hover { text-decoration: underline; }

    /* Steps */
    .steps { display: grid; grid-template-columns: 1fr 1.15fr; gap: 32px; align-items: stretch; }
    .step-tabs { display: grid; gap: 12px; align-content: start; }
    .step-tab {
      text-align: left; padding: 20px; border-radius: 12px; border: 1px solid var(--border); background: transparent;
      display: grid; grid-template-columns: 36px 1fr; gap: 16px; align-items: start;
      transition: background .2s, border-color .2s;
    }
    .step-tab:hover { background: var(--surface); }
    .step-tab[aria-selected="true"] { background: var(--surface); border-color: var(--accent-text); }
    .step-num {
      width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 15px;
      border: 1px solid var(--border); color: var(--muted); transition: all .2s;
    }
    .step-tab[aria-selected="true"] .step-num { background: var(--accent); border-color: var(--accent); color: #fff; }
    .step-tab h3 { margin: 0 0 4px; font-size: 18px; }
    .step-tab p { margin: 0; color: var(--muted); font-size: 15px; }
    .step-tab .extra { max-height: 0; overflow: hidden; opacity: 0; transition: max-height .35s, opacity .35s, margin .35s; }
    .step-tab[aria-selected="true"] .extra { max-height: 120px; opacity: 1; margin-top: 8px; }

    .terminal { background: #010409; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; min-height: 320px; display: flex; flex-direction: column; box-shadow: var(--shadow); }
    .term-bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: #161b22; border-bottom: 1px solid #30363d; }
    .term-bar i { width: 12px; height: 12px; border-radius: 50%; display: block; background: #484f58; }
    .term-bar span { margin-left: 8px; font: 13px var(--mono); color: #8b949e; }
    .term-body { padding: 20px; font: 14px/1.9 var(--mono); color: #e6edf3; overflow-x: auto; }
    .term-line { white-space: pre; opacity: 0; animation: line .3s forwards; animation-delay: calc(var(--i) * 260ms); }
    .term-line.cmd::before { content: "$ "; color: #3fb950; }
    .term-line.out { color: #8b949e; }
    .term-line.ok { color: #3fb950; }
    @keyframes line { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    .caret { display: inline-block; width: 8px; height: 16px; background: #e6edf3; vertical-align: -3px; animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    /* Project cards */
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card {
      display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: 12px;
      background: var(--surface); border: 1px solid var(--border);
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }
    .card:hover { border-color: var(--link); transform: translateY(-3px); box-shadow: var(--shadow); }
    .card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .repo { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--link); min-width: 0; }
    .repo span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .card p { margin: 0; color: var(--muted); font-size: 14px; flex: 1; }
    .card-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--muted); flex-wrap: wrap; }
    .star {
      display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; font-size: 13px; font-weight: 500;
      background: var(--bg); border: 1px solid var(--border); border-radius: 6px; color: var(--text);
      transition: background .15s, border-color .15s;
    }
    .star:hover { background: var(--surface-2); }
    .star svg { transition: transform .3s cubic-bezier(.3, 1.8, .5, 1), fill .2s; fill: none; stroke: currentColor; stroke-width: 1.2; }
    .star[aria-pressed="true"] { border-color: #d29922; }
    .star[aria-pressed="true"] svg { fill: #e3b341; stroke: #e3b341; transform: scale(1.25) rotate(72deg); }
    .gfi-count { color: var(--accent-text); font-weight: 500; }

    /* CTA */
    .cta {
      text-align: center; padding: 72px 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface);
      position: relative; overflow: hidden;
    }
    .cta h2 { margin: 0 0 12px; font-size: clamp(1.8rem, 3.6vw, 2.7rem); letter-spacing: -.03em; text-wrap: balance; }
    .cta p { margin: 0 auto 28px; color: var(--muted); font-size: 18px; max-width: 48ch; }
    .cta .hero-cta { justify-content: center; }

    /* Footer */
    footer { margin-top: 96px; border-top: 1px solid var(--border); padding: 56px 0 40px; color: var(--muted); font-size: 14px; }
    .foot-grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 32px; }
    .foot-grid h4 { margin: 0 0 12px; color: var(--text); font-size: 14px; }
    .foot-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .foot-grid a:hover { color: var(--link); text-decoration: underline; }
    .foot-brand p { margin: 12px 0 0; max-width: 32ch; }
    .foot-bottom { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

    /* Toast */
    .toast {
      position: fixed; left: 50%; bottom: 28px; z-index: 300; transform: translate(-50%, 24px); opacity: 0; pointer-events: none;
      background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 10px 16px; font-size: 14px; box-shadow: var(--shadow);
      display: flex; align-items: center; gap: 10px; transition: opacity .25s, transform .25s;
    }
    .toast.show { opacity: 1; transform: translate(-50%, 0); }
    .toast svg { color: var(--accent-text); }

    /* ---------- Responsive ---------- */
    @media (max-width: 1000px) {
      .hero-grid { grid-template-columns: 1fr; gap: 40px; }
      .steps { grid-template-columns: 1fr; }
      .grid { grid-template-columns: repeat(2, 1fr); }
      .foot-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 900px) {
      .nav-links, .search, .nav-right .signin, .nav-right .btn-primary { display: none; }
      .burger { display: grid; }
      .mobile-panel { display: block; }
    }
    @media (max-width: 640px) {
      .container { width: calc(100% - 32px); }
      .hero { padding-top: 40px; }
      .grid { grid-template-columns: 1fr; }
      .stats-row { grid-template-columns: 1fr; }
      .stat + .stat { border-left: 0; border-top: 1px solid var(--border); }
      .heat-grid { gap: 3px; }
      section.block { padding-top: 72px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-delay: 0ms !important; transition-duration: .01ms !important; }
      html { scroll-behavior: auto; }
    }
  </style>
