<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Activity Stats | DevNexus</title>
  <%- include('partials/theme-script') %>
  <link rel="stylesheet" href="/css/sparkles.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/streak.css">
  <style>
    .stats-main { padding: 32px 0 60px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .stat-pill { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px 18px; text-align: center; }
    .stat-pill .num { font-size: 2.2rem; font-weight: 800; color: var(--accent-text); line-height: 1; }
    .stat-pill .lbl { font-size: 12px; color: var(--muted); margin-top: 6px; }
    .chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-bottom: 28px; }
    .chart-title { font-size: 14px; font-weight: 700; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
    /* Area chart */
    .area-chart-wrap { width: 100%; overflow-x: auto; }
    .area-chart-wrap svg { display: block; }
    /* Bar chart */
    .bar-chart { display: flex; align-items: flex-end; gap: 6px; height: 120px; padding-top: 8px; }
    .bar-col { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 28px; }
    .bar-fill { width: 100%; border-radius: 4px 4px 0 0; background: linear-gradient(180deg, var(--accent-text), #6a5acd); transition: height 0.3s; min-height: 2px; }
    .bar-label { font-size: 9px; color: var(--muted); margin-top: 4px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 44px; }
    .bar-val { font-size: 9px; color: var(--accent-text); margin-bottom: 2px; }
    /* Donut */
    .donut-wrap { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
    .donut-legend { display: flex; flex-direction: column; gap: 10px; flex: 1; min-width: 140px; }
    .legend-item { display: flex; align-items: center; gap: 8px; font-size: 12.5px; }
    .legend-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
    /* Calendar heatmap enhanced */
    .cal-row { display: flex; gap: 4px; margin-bottom: 6px; align-items: center; }
    .cal-label { font-size: 10px; color: var(--muted); width: 28px; text-align: right; flex-shrink: 0; }
    .cal-cells { display: flex; gap: 3px; flex-wrap: wrap; }
    .cal-cell { width: 14px; height: 14px; border-radius: 3px; background: var(--border); position: relative; cursor: default; }
    .cal-cell[data-active="1"] { background: #4ade80; }
    .cal-cell[data-active="2"] { background: #22c55e; }
    .cal-cell[data-active="3"] { background: #16a34a; }
    .cal-cell[data-today="1"] { outline: 2px solid var(--accent-text); outline-offset: 1px; }
    .cal-cell:hover::after { content: attr(title); position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 4px 8px; font-size: 10px; white-space: nowrap; z-index: 10; color: var(--text); pointer-events: none; }
    .cal-legend { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); margin-top: 10px; }
    .cal-swatch { width: 12px; height: 12px; border-radius: 2px; }
    /* Sparkline */
    .sparkline-wrap { width: 100%; overflow-x: auto; }
    .x-axis-labels { display: flex; justify-content: space-between; margin-top: 4px; }
    .x-axis-labels span { font-size: 9px; color: var(--muted); }
    @media (max-width: 600px) {
      .donut-wrap { flex-direction: column; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <%- include('partials/sparkles-bg') %>
  <%- include('partials/dashboard-nav', { activePage: 'stats', siteName: 'DevNexus', user: locals.user, isAdmin: (locals.user && locals.user.role === 'admin') }) %>

  <aside class="disclosure-banner" aria-label="Stats Notice">
    <div class="container disclosure-inner">
      <div style="display:flex; align-items:center; gap:8px;">
        <span class="disclosure-badge">Activity Insights</span>
        <span>Your <strong>Contribution Analytics</strong> — activity breakdown, streak trends, and progress overview.</span>
      </div>
      <span style="font-size:12px; font-family:var(--mono); color:var(--accent-text);">Member 3 &bull; Data Visualization</span>
    </div>
  </aside>

  <main class="stats-main" id="main">
    <div class="container">

      <!-- SUMMARY PILLS -->
      <div class="stats-grid">
        <div class="stat-pill">
          <div class="num">🔥 <%= streak.current_streak %></div>
          <div class="lbl">Current Streak</div>
        </div>
        <div class="stat-pill">
          <div class="num">🏆 <%= streak.longest_streak %></div>
          <div class="lbl">Longest Streak</div>
        </div>
        <div class="stat-pill">
          <div class="num">📅 <%= streak.total_active_days %></div>
          <div class="lbl">Total Active Days</div>
        </div>
        <div class="stat-pill">
          <div class="num">📌 <%= bookmarksCount %></div>
          <div class="lbl">Issues Bookmarked</div>
        </div>
        <div class="stat-pill">
          <div class="num">🗺️ <%= roadmapCount %></div>
          <div class="lbl">Roadmap Steps Done</div>
        </div>
        <div class="stat-pill">
          <div class="num">🏅 <%= badgesCount %></div>
          <div class="lbl">Badges Earned</div>
        </div>
      </div>

      <!-- AREA CHART: 90-day activity sparkline -->
      <div class="chart-card">
        <div class="chart-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          90-Day Contribution Activity
        </div>
        <div class="area-chart-wrap" id="area-chart-wrap"></div>
        <div class="x-axis-labels" id="x-axis-labels"></div>
      </div>

      <!-- GRID: activity breakdown donut + bar chart -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:28px;" id="charts-row">

        <!-- DONUT: activity type breakdown -->
        <div class="chart-card">
          <div class="chart-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Activity Type Breakdown
          </div>
          <div class="donut-wrap">
            <svg id="donut-svg" width="130" height="130" viewBox="0 0 130 130"></svg>
            <div class="donut-legend" id="donut-legend"></div>
          </div>
        </div>

        <!-- BAR: weekly activity bar chart -->
        <div class="chart-card">
          <div class="chart-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="18" y="3" width="4" height="18"/><rect x="10" y="8" width="4" height="13"/><rect x="2" y="13" width="4" height="8"/></svg>
            Weekly Activity (Last 12 Weeks)
          </div>
          <div class="bar-chart" id="bar-chart"></div>
        </div>

      </div>

      <!-- CONTRIBUTION CALENDAR — enhanced 90-day heatmap -->
      <div class="chart-card">
        <div class="chart-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          90-Day Contribution Calendar
        </div>
        <div id="cal-container" style="overflow-x:auto;"></div>
        <div class="cal-legend">
          <span>Less</span>
          <div class="cal-swatch" style="background:var(--border);"></div>
          <div class="cal-swatch" style="background:#4ade80;"></div>
          <div class="cal-swatch" style="background:#22c55e;"></div>
          <div class="cal-swatch" style="background:#16a34a;"></div>
          <span>More</span>
        </div>
      </div>

      <!-- QUICK LINKS -->
      <div class="streak-actions-grid" style="margin-top:8px;">
        <a href="/streak" class="streak-action-card">
          <span class="streak-action-icon">🔥</span>
          <div><div class="streak-action-title">Streak Dashboard</div><div class="streak-action-sub">View milestones & freeze shields</div></div>
        </a>
        <a href="/badges" class="streak-action-card">
          <span class="streak-action-icon">🏆</span>
          <div><div class="streak-action-title">Achievement Badges</div><div class="streak-action-sub">See all unlocked trophies</div></div>
        </a>
        <a href="/dashboard" class="streak-action-card">
          <span class="streak-action-icon">📊</span>
          <div><div class="streak-action-title">Developer Dashboard</div><div class="streak-action-sub">Browse issues & GitHub activity</div></div>
        </a>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    // Data injected from server
    const DAILY_DATA = <%- JSON.stringify(daily) %>;
    const BREAKDOWN_DATA = <%- JSON.stringify(breakdown) %>;

    // ── Colour palette ──────────────────────────────────────────────────────
    const PALETTE = ['#a78bfa','#60a5fa','#34d399','#f97316','#f43f5e','#facc15','#38bdf8','#c084fc'];

    function labelFor(type) {
      const map = {
        dashboard_visit: 'Dashboard Visit', bookmark_added: 'Bookmark Added',
        roadmap_step: 'Roadmap Step', skill_node_unlocked: 'Skill Unlocked',
        streak_page_visit: 'Streak Page', manual_ping: 'Manual Check-in',
        manual_checkin: 'Manual Check-in', streak_freeze_shield: 'Freeze Shield',
        test_seed: 'Seed Data', general: 'General'
      };
      return map[type] || type.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    // ── Build a date-keyed map from daily data ──────────────────────────────
    function buildDailyMap() {
      const map = {};
      DAILY_DATA.forEach(r => { map[r.activity_date] = Number(r.count); });
      return map;
    }

    function getDateStr(d) {
      return d.toISOString().split('T')[0];
    }

    function daysAgo(n) {
      const d = new Date();
      d.setDate(d.getDate() - n);
      return d;
    }

    // ── 1. Area / Sparkline chart (SVG) ─────────────────────────────────────
    function buildAreaChart() {
      const wrap = document.getElementById('area-chart-wrap');
      const W = wrap.clientWidth || 700;
      const H = 120;
      const PAD = { top: 10, right: 10, bottom: 20, left: 32 };
      const map = buildDailyMap();

      const days = 90;
      const points = [];
      for (let i = days - 1; i >= 0; i--) {
        const d = daysAgo(i);
        const ds = getDateStr(d);
        points.push({ date: ds, count: map[ds] || 0 });
      }

      const maxVal = Math.max(...points.map(p => p.count), 1);
      const plotW = W - PAD.left - PAD.right;
      const plotH = H - PAD.top - PAD.bottom;

      const xs = points.map((_, i) => PAD.left + (i / (points.length - 1)) * plotW);
      const ys = points.map(p => PAD.top + plotH - (p.count / maxVal) * plotH);

      // Build smooth path using cubic bezier
      let pathD = `M ${xs[0]} ${ys[0]}`;
      for (let i = 1; i < xs.length; i++) {
        const cpx = (xs[i - 1] + xs[i]) / 2;
        pathD += ` C ${cpx} ${ys[i-1]}, ${cpx} ${ys[i]}, ${xs[i]} ${ys[i]}`;
      }
      const areaD = pathD + ` L ${xs[xs.length-1]} ${PAD.top + plotH} L ${xs[0]} ${PAD.top + plotH} Z`;

      // Y-axis labels
      const yLabels = [0, Math.ceil(maxVal / 2), maxVal].map((v, i) => {
        const y = PAD.top + plotH - (v / maxVal) * plotH;
        return `<text x="${PAD.left - 6}" y="${y + 4}" text-anchor="end" fill="var(--muted)" font-size="9">${v}</text>`;
      }).join('');

      // Grid lines
      const gridLines = [0, 0.5, 1].map(r => {
        const y = PAD.top + plotH - r * plotH;
        return `<line x1="${PAD.left}" y1="${y}" x2="${PAD.left + plotW}" y2="${y}" stroke="var(--border)" stroke-dasharray="4,4"/>`;
      }).join('');

      // Today dot
      const todayDot = `<circle cx="${xs[xs.length-1]}" cy="${ys[xs.length-1]}" r="4" fill="var(--accent-text)"/>`;

      const gradId = 'area-grad-' + Date.now();
      const svg = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent-text)" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="var(--accent-text)" stop-opacity="0.03"/>
          </linearGradient>
        </defs>
        ${gridLines}
        ${yLabels}
        <path d="${areaD}" fill="url(#${gradId})"/>
        <path d="${pathD}" fill="none" stroke="var(--accent-text)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        ${todayDot}
      </svg>`;

      wrap.innerHTML = svg;

      // X-axis date labels (every ~15 days)
      const xl = document.getElementById('x-axis-labels');
      xl.innerHTML = '';
      [0, 30, 60, 89].forEach(i => {
        const sp = document.createElement('span');
        sp.textContent = points[i].date.slice(5);
        xl.appendChild(sp);
      });
    }

    // ── 2. Donut chart (SVG) ────────────────────────────────────────────────
    function buildDonut() {
      const svg = document.getElementById('donut-svg');
      const legend = document.getElementById('donut-legend');
      const CX = 65, CY = 65, R = 48, IR = 28;

      if (!BREAKDOWN_DATA.length) {
        svg.innerHTML = `<text x="65" y="70" text-anchor="middle" fill="var(--muted)" font-size="11">No data yet</text>`;
        legend.innerHTML = '<span style="color:var(--muted);font-size:12px;">Log some activity to see breakdown</span>';
        return;
      }

      const total = BREAKDOWN_DATA.reduce((s, r) => s + Number(r.count), 0);
      let startAngle = -Math.PI / 2;
      let paths = '';

      BREAKDOWN_DATA.forEach((r, i) => {
        const frac = Number(r.count) / total;
        const angle = frac * 2 * Math.PI;
        const endAngle = startAngle + angle;
        const x1 = CX + R * Math.cos(startAngle);
        const y1 = CY + R * Math.sin(startAngle);
        const x2 = CX + R * Math.cos(endAngle);
        const y2 = CY + R * Math.sin(endAngle);
        const ix1 = CX + IR * Math.cos(endAngle);
        const iy1 = CY + IR * Math.sin(endAngle);
        const ix2 = CX + IR * Math.cos(startAngle);
        const iy2 = CY + IR * Math.sin(startAngle);
        const large = angle > Math.PI ? 1 : 0;
        const color = PALETTE[i % PALETTE.length];
        paths += `<path d="M${x1},${y1} A${R},${R} 0 ${large},1 ${x2},${y2} L${ix1},${iy1} A${IR},${IR} 0 ${large},0 ${ix2},${iy2} Z" fill="${color}" opacity="0.9">
          <title>${labelFor(r.activity_type)}: ${r.count}</title></path>`;
        startAngle = endAngle;

        // Legend
        const item = document.createElement('div');
        item.className = 'legend-item';
        item.innerHTML = `<div class="legend-dot" style="background:${color}"></div>
          <span style="color:var(--text)">${labelFor(r.activity_type)}</span>
          <span style="color:var(--muted);margin-left:auto">${r.count}</span>`;
        legend.appendChild(item);
      });

      svg.innerHTML = paths + `<circle cx="${CX}" cy="${CY}" r="${IR - 2}" fill="var(--surface)"/>
        <text x="${CX}" y="${CY - 5}" text-anchor="middle" fill="var(--accent-text)" font-size="13" font-weight="700">${total}</text>
        <text x="${CX}" y="${CY + 10}" text-anchor="middle" fill="var(--muted)" font-size="9">actions</text>`;
    }

    // ── 3. Weekly bar chart ─────────────────────────────────────────────────
    function buildBarChart() {
      const container = document.getElementById('bar-chart');
      const map = buildDailyMap();
      const weeks = [];

      for (let w = 11; w >= 0; w--) {
        let count = 0;
        let label = '';
        for (let d = 0; d < 7; d++) {
          const daysBack = w * 7 + d;
          const ds = getDateStr(daysAgo(daysBack));
          count += (map[ds] || 0);
          if (d === 3) label = ds.slice(5);
        }
        weeks.push({ label, count });
      }

      const maxW = Math.max(...weeks.map(w => w.count), 1);
      container.innerHTML = weeks.map(w => {
        const pct = Math.round((w.count / maxW) * 100);
        return `<div class="bar-col">
          <div class="bar-val">${w.count || ''}</div>
          <div class="bar-fill" style="height:${Math.max(pct, w.count > 0 ? 4 : 0)}%;"></div>
          <div class="bar-label">${w.label}</div>
        </div>`;
      }).join('');
    }

    // ── 4. 90-day calendar heatmap ──────────────────────────────────────────
    function buildCalendar() {
      const container = document.getElementById('cal-container');
      const map = buildDailyMap();
      const today = getDateStr(new Date());
      const maxCount = Math.max(...Object.values(map), 1);

      // Build 90-day grid in week columns
      const DAYS = 90;
      const grid = document.createElement('div');
      grid.style.cssText = 'display:flex; gap:3px;';

      const startDay = daysAgo(DAYS - 1);
      const startDow = startDay.getDay(); // 0=Sun

      // Fill weeks
      let col = document.createElement('div');
      col.style.cssText = 'display:flex; flex-direction:column; gap:3px;';

      // Blank cells before start
      for (let pad = 0; pad < startDow; pad++) {
        const blank = document.createElement('div');
        blank.style.cssText = 'width:14px;height:14px;';
        col.appendChild(blank);
      }

      for (let i = 0; i < DAYS; i++) {
        const d = daysAgo(DAYS - 1 - i);
        const ds = getDateStr(d);
        const count = map[ds] || 0;
        const dow = d.getDay();

        const cell = document.createElement('div');
        cell.className = 'cal-cell';
        cell.title = `${ds}: ${count} action${count !== 1 ? 's' : ''}`;
        if (ds === today) cell.dataset.today = '1';
        if (count > 0) {
          cell.dataset.active = count >= 3 ? '3' : count >= 2 ? '2' : '1';
        }
        col.appendChild(cell);

        if (dow === 6 && i < DAYS - 1) {
          grid.appendChild(col);
          col = document.createElement('div');
          col.style.cssText = 'display:flex; flex-direction:column; gap:3px;';
        }
      }
      if (col.children.length) grid.appendChild(col);

      container.appendChild(grid);
    }

    // ── Init ────────────────────────────────────────────────────────────────
    function initCharts() {
      buildAreaChart();
      buildDonut();
      buildBarChart();
      buildCalendar();

      // Mobile: stack charts-row
      if (window.innerWidth < 640) {
        const row = document.getElementById('charts-row');
        if (row) row.style.gridTemplateColumns = '1fr';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCharts);
    } else {
      initCharts();
    }

    window.addEventListener('resize', () => {
      const wrap = document.getElementById('area-chart-wrap');
      if (wrap) { wrap.innerHTML = ''; buildAreaChart(); }
    });
  </script>
</body>
</html>
