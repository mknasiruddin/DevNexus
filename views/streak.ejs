<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Contribution Streaks | DevNexus</title>
  <meta name="description" content="Track your open-source contribution streaks, daily engagement, and unlock consistency badges on DevNexus.">
  <%- include('partials/theme-script') %>
  <link rel="stylesheet" href="/css/sparkles.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/streak.css">
</head>
<body>
  <%- include('partials/sparkles-bg') %>

  <!-- NAVBAR -->
  <%- include('partials/dashboard-nav', { activePage: 'streak', siteName: 'DevNexus', user: locals.user, isAdmin: (locals.user && locals.user.role === 'admin') }) %>

  <!-- DISCLOSURE BANNER -->
  <aside class="disclosure-banner" aria-label="Streak Feature Notice">
    <div class="container disclosure-inner">
      <div style="display:flex; align-items:center; gap:8px;">
        <span class="disclosure-badge">Gamification Module</span>
        <span>Developer <strong>Contribution Streaks</strong> &amp; Consistency Milestones. Stored in persistent SQLite.</span>
      </div>
      <div>
        <span style="font-size: 12px; font-family: var(--mono); color: var(--accent-text);">
          Member 3 &bull; Open-Source Habit Tracking
        </span>
      </div>
    </div>
  </aside>

  <!-- MAIN STREAK CONTENT -->
  <main class="streak-main" id="main">
    <div class="container">

      <!-- HERO STREAK CARD -->
      <section class="streak-hero-card" aria-label="Current Streak Summary">
        <div class="streak-hero-left">
          <div class="streak-giant-flame" aria-hidden="true">🔥</div>
          <div>
            <div class="streak-hero-count">
              <%= streak.current_streak %><span>days</span>
            </div>
            <div style="display:flex; align-items:center; gap:8px; margin-top:4px;">
              <% if (streak.activeToday) { %>
                <span class="streak-badge-active">Active Today</span>
              <% } else { %>
                <span class="streak-badge-pending">Pending Activity Today</span>
              <% } %>
              <span style="font-size:12.5px; color:var(--muted);">&bull; <%= streak.statusMessage %></span>
            </div>
            <p class="streak-hero-sub">
              Consistency is the superpower of impactful open-source developers. Code, review, or bookmark daily to keep the fire burning.
            </p>
          </div>
        </div>

        <div class="streak-hero-actions">
          <button id="btn-streak-ping" class="btn btn-primary" onclick="pingStreakActivity()">
            🔥 Log Today's Activity
          </button>
          <% if (streak.streak_freeze_count > 0) { %>
            <button id="btn-streak-freeze" class="btn" onclick="activateStreakFreeze()">
              🛡️ Use Freeze Shield (<%= streak.streak_freeze_count %> left)
            </button>
          <% } %>
        </div>
      </section>

      <!-- 4 METRIC STATS -->
      <section class="streak-stats-row" aria-label="Streak Metric Statistics">
        <div class="streak-stat-box">
          <div class="streak-stat-icon">🔥</div>
          <div>
            <div class="streak-stat-val" id="metric-current-streak"><%= streak.current_streak %></div>
            <div class="streak-stat-label">Current Day Streak</div>
          </div>
        </div>

        <div class="streak-stat-box">
          <div class="streak-stat-icon">🏆</div>
          <div>
            <div class="streak-stat-val" id="metric-longest-streak"><%= streak.longest_streak %></div>
            <div class="streak-stat-label">All-Time Best Streak</div>
          </div>
        </div>

        <div class="streak-stat-box">
          <div class="streak-stat-icon">📅</div>
          <div>
            <div class="streak-stat-val" id="metric-total-active"><%= streak.total_active_days %></div>
            <div class="streak-stat-label">Total Active Days</div>
          </div>
        </div>

        <div class="streak-stat-box">
          <div class="streak-stat-icon">🛡️</div>
          <div>
            <div class="streak-stat-val" id="metric-freeze-count"><%= streak.streak_freeze_count %></div>
            <div class="streak-stat-label">Freeze Shields Available</div>
          </div>
        </div>
      </section>

      <!-- NEXT UPCOMING MILESTONE -->
      <% if (streak.nextMilestone) { %>
        <div style="background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:18px 24px; margin-bottom:28px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
            <div style="font-size:14px; font-weight:700;">
              Next Milestone: <span style="color:var(--accent-text);"><%= streak.nextMilestone.icon %> <%= streak.nextMilestone.title %></span>
            </div>
            <div style="font-size:12px; color:var(--muted); font-family:var(--mono);">
              <%= streak.nextMilestone.daysLeft %> <%= streak.nextMilestone.daysLeft === 1 ? 'day' : 'days' %> remaining (<%= streak.nextMilestone.percent %>%)
            </div>
          </div>
          <div class="milestone-bar-outer" style="height:8px;">
            <div class="milestone-bar-fill" style="width: <%= streak.nextMilestone.percent %>%;"></div>
          </div>
        </div>
      <% } %>

      <!-- 7-DAY TIMELINE & 30-DAY HEATMAP -->
      <section class="streak-calendar-card" aria-label="Activity Heatmap and Consistency Grid">
        <div class="streak-card-title-row">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            7-Day Recent Consistency
          </h3>
          <span style="font-size:12px; color:var(--muted);">Current Week Activity</span>
        </div>

        <div class="streak-dots-row" style="padding:14px; margin-bottom:24px;">
          <% (streak.recentWeek || []).forEach(function(day) { %>
            <div class="streak-dot-col <%= day.isToday ? 'is-today' : '' %>" title="<%= day.date %>: <%= day.active ? 'Active contribution recorded' : 'No activity recorded' %>">
              <div class="streak-dot <%= day.active ? 'dot-active' : 'dot-inactive' %>" style="width:32px; height:32px; font-size:14px;">
                <% if (day.active) { %>&#10003;<% } else { %>&bull;<% } %>
              </div>
              <span class="streak-dot-label" style="font-size:11px; margin-top:4px;"><%= day.dayName %></span>
              <span style="font-size:9.5px; color:var(--muted);"><%= day.date.slice(5) %></span>
            </div>
          <% }); %>
        </div>

        <div class="streak-card-title-row" style="margin-top:20px;">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            30-Day Contribution Heatmap
          </h3>
          <span style="font-size:12px; color:var(--muted);">Last 30 Calendar Days</span>
        </div>

        <div class="streak-grid-30">
          <% (streak.recentMonth || []).forEach(function(day) { %>
            <div class="streak-day-cell <%= day.active ? 'cell-active' : 'cell-empty' %> <%= day.isToday ? 'cell-today' : '' %>"
                 title="<%= day.date %> (<%= day.dayName %>): <%= day.active ? 'Active' : 'No activity' %>">
              <%= day.date.split('-')[2] %>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- STREAK MILESTONES & ACHIEVEMENTS -->
      <section aria-label="Streak Milestones and Badges">
        <div class="streak-card-title-row">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
            Streak Milestones &amp; Consistency Badges
          </h3>
          <span style="font-size:12px; color:var(--muted);">Earned through unbroken dedication</span>
        </div>

        <div class="streak-milestones-grid">
          <% (streak.milestones || []).forEach(function(m) { %>
            <div class="milestone-badge-card <%= m.unlocked ? 'unlocked' : 'locked' %>">
              <div class="milestone-header">
                <div class="milestone-icon"><%= m.icon %></div>
                <div>
                  <div class="milestone-title"><%= m.title %></div>
                  <div style="font-size:11px; color:var(--muted);"><%= m.days %>-Day Unbroken Streak</div>
                </div>
                <span class="milestone-tier-pill tier-<%= m.tier %>"><%= m.tier %></span>
              </div>
              <p class="milestone-desc"><%= m.description %></p>
              <div>
                <div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:4px; color:var(--muted);">
                  <span><%= m.unlocked ? 'Unlocked ✓' : 'In Progress' %></span>
                  <span><%= m.progress %>%</span>
                </div>
                <div class="milestone-bar-outer">
                  <div class="milestone-bar-fill" style="width: <%= m.progress %>%;"></div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>

      <!-- QUICK ACTIONS TO EXTEND STREAK -->
      <section aria-label="Maintain Streak Suggestions" style="margin-top:20px;">
        <div class="streak-card-title-row">
          <h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
            Maintain Your Streak Today
          </h3>
          <span style="font-size:12px; color:var(--muted);">Actions that count toward your open-source growth</span>
        </div>

        <div class="streak-actions-grid">
          <a href="/projects?topic=good-first-issue" class="streak-action-card">
            <span class="streak-action-icon">🎯</span>
            <div>
              <div class="streak-action-title">Good First Issues</div>
              <div class="streak-action-sub">Tackle curated beginner-friendly tasks</div>
            </div>
          </a>

          <a href="/roadmap" class="streak-action-card">
            <span class="streak-action-icon">🗺️</span>
            <div>
              <div class="streak-action-title">14-Stage Roadmap</div>
              <div class="streak-action-sub">Check off your next open-source milestone</div>
            </div>
          </a>

          <a href="/skill-tree" class="streak-action-card">
            <span class="streak-action-icon">🧠</span>
            <div>
              <div class="streak-action-title">Interactive Skill Tree</div>
              <div class="streak-action-sub">Unlock technical nodes across 4 tracks</div>
            </div>
          </a>

          <a href="/projects" class="streak-action-card">
            <span class="streak-action-icon">⭐</span>
            <div>
              <div class="streak-action-title">Bookmark Repositories</div>
              <div class="streak-action-sub">Save issues to investigate and contribute</div>
            </div>
          </a>
        </div>
      </section>

    </div>
  </main>

  <%- include('partials/footer') %>

  <!-- STREAK CLIENT INTERACTIONS SCRIPT -->
  <script>
    async function pingStreakActivity() {
      const btn = document.getElementById('btn-streak-ping');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch('/api/streak/ping', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ activityType: 'manual_ping' })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to record streak activity.');
          if (btn) btn.disabled = false;
        }
      } catch (err) {
        alert('Network error while recording activity.');
        if (btn) btn.disabled = false;
      }
    }

    async function activateStreakFreeze() {
      if (!confirm('Activate a streak freeze shield to protect your streak from a missed day?')) return;
      const btn = document.getElementById('btn-streak-freeze');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch('/api/streak/freeze', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Freeze shield activated!');
          window.location.reload();
        } else {
          alert(data.message || data.error || 'Failed to activate freeze shield.');
          if (btn) btn.disabled = false;
        }
      } catch (err) {
        alert('Network error while activating streak freeze.');
        if (btn) btn.disabled = false;
      }
    }
  </script>
</body>
</html>

