<%
  const skillDotColors = {
    javascript: '#f1e05a',
    typescript: '#3178c6',
    python: '#3572A5',
    go: '#00ADD8',
    rust: '#dea584',
    java: '#b07219',
    'node.js': '#68a063',
    react: '#61dafb',
    docs: '#8b949e'
  };
  const effectiveSkills = (Array.isArray(locals.userSkills) && userSkills.length > 0)
    ? userSkills
    : ['JavaScript', 'Python', 'TypeScript'];
  const expLevel = (user && user.experience_level) ? user.experience_level : 'Beginner';
%>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Developer Dashboard | DevNexus</title>
  <meta name="description" content="DevNexus Developer Dashboard - Live GitHub profile, real open-source issue recommendations, and persistent bookmarks.">
  <%- include('partials/theme-script') %>
  <link rel="stylesheet" href="/css/sparkles.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/streak.css">
</head>
<body>
  <%- include('partials/sparkles-bg') %>

  <!-- ======================= NAVBAR ======================= -->
  <%- include('partials/dashboard-nav', { activePage: 'dashboard', siteName: 'DevNexus' }) %>

  <!-- ======================= LIVE API & PERSISTENCE NOTICE ======================= -->
  <aside class="disclosure-banner" aria-label="API and Storage Notice">
    <div class="container disclosure-inner">
      <div style="display:flex; align-items:center; gap:8px;">
        <span class="disclosure-badge">Live Integration</span>
        <span>Connected to <strong>GitHub REST API v3</strong>. Bookmarks and user data stored in persistent SQLite.</span>
      </div>
      <div>
        <% if (rateLimit) { %>
          <span style="font-size: 12px; font-family: var(--mono);" title="Core / Search REST rate limits">
            API Quota: <strong><%= rateLimit.remaining %></strong> / <%= rateLimit.limit %> remaining
            <% if (rateLimit.resetInMinutes > 0) { %>(resets in <%= rateLimit.resetInMinutes %>m)<% } %>
          </span>
        <% } %>
      </div>
    </div>
  </aside>

  <!-- ======================= MAIN CONTENT ======================= -->
  <main class="dashboard-main" id="main">
    <div class="container">

      <% if (locals.profileUpdated) { %>
        <div style="padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; background: rgba(34, 197, 94, 0.14); border: 1px solid rgba(34, 197, 94, 0.35); color: #4ade80; font-size: 13.5px; display: flex; align-items: center; gap: 10px;" role="status">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          <span>Your developer profile, experience level, and skill preferences have been updated in SQLite.</span>
        </div>
      <% } %>

      <!-- Rate Limit or API Error Notice -->
      <% if (locals.issueError === 'RATE_LIMIT_EXCEEDED') { %>
        <div class="error-banner" role="alert">
          <div style="display:flex; align-items:center; gap:8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
              <strong>GitHub API Rate Limit Reached:</strong>
              <%= issueErrorMessage || 'Unauthenticated requests are limited by GitHub. The limit will reset shortly.' %>
              <% if (!user && !isOAuthConfigured) { %>
                Sign in with GitHub or configure <code>GITHUB_TOKEN</code> in <code>.env</code> for 5,000 requests/hour.
              <% } %>
            </div>
          </div>
        </div>
      <% } else if (locals.issueError) { %>
        <div class="error-banner" role="alert">
          <span><strong>API Notice:</strong> <%= issueErrorMessage || 'Unable to retrieve live issues. Please verify your connection.' %></span>
        </div>
      <% } %>

      <div class="dash-grid">
        <!-- ======================= PROFILE SIDEBAR ======================= -->
        <aside class="profile-card" aria-label="Developer Profile">
          <div class="profile-header">
            <img class="profile-avatar-lg" src="<%= profile.avatar_url %>" alt="<%= profile.name || profile.login %> avatar">
            <h2 class="profile-name-lg"><%= (targetUsername === user.username && user.name) ? user.name : (profile.name || profile.login) %></h2>
            <a href="https://github.com/<%= profile.login %>" target="_blank" rel="noopener noreferrer" class="profile-handle" title="View profile on GitHub">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              @<%= profile.login %>
            </a>
            <p class="profile-bio"><%= (targetUsername === user.username && user.bio) ? user.bio : (profile.bio || 'Open-source software contributor exploring impactful community projects.') %></p>

            <% if (user) { %>
              <div style="margin-top: 10px;">
                <span class="level-badge intermediate" title="Experience Level">
                  <span class="status-dot online"></span> <%= expLevel %> Contributor
                </span>
                <div style="margin-top: 10px; display: flex; gap: 6px; justify-content: center; flex-wrap: wrap;">
                  <a href="/onboarding?edit=1" class="btn btn-sm" style="font-size: 11.5px;">Edit Profile &amp; Skills</a>
                  <a href="/auth/logout" class="btn btn-sm" style="font-size: 11.5px;">Sign Out</a>
                </div>
              </div>
            <% } else { %>
              <div style="margin-top: 10px;">
                <a href="/auth/github" class="btn btn-sm btn-primary" style="width: 100%;">
                  Sign In with GitHub
                </a>
              </div>
            <% } %>
          </div>

          <!-- Switch GitHub Handle Form -->
          <form action="/dashboard" method="GET" style="margin-bottom: 16px;">
            <label for="inspect-username-input" style="display:block; font-size:11px; font-weight:600; color:var(--muted); margin-bottom:4px; text-transform:uppercase; letter-spacing:0.04em;">Inspect GitHub Handle</label>
            <div style="display:flex; gap:6px;">
              <input id="inspect-username-input" type="text" name="username" value="<%= targetUsername %>" placeholder="your-github-username" aria-label="GitHub username to inspect" style="flex:1; height:32px; padding:0 8px; font-size:12px; background:var(--bg); border:1px solid var(--border); border-radius:6px; color:var(--text); outline:none;">
              <button type="submit" class="btn btn-sm">Inspect</button>
            </div>
            <% if (targetUsername !== user.username) { %>
              <div style="margin-top: 6px; font-size: 11.5px;">
                Inspecting <strong>@<%= targetUsername %></strong> &bull; <a href="/dashboard" style="color: var(--link);">Reset to @<%= user.username %></a>
              </div>
            <% } %>
          </form>

          <ul class="meta-list">
            <li class="meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>GitHub member since <%= new Date(profile.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></span>
            </li>
            <li class="meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span><strong><%= profile.followers %></strong> followers &bull; <strong><%= profile.following %></strong> following</span>
            </li>
            <li class="meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              <span>Database Bookmarks: <strong id="sidebar-bookmark-count"><%= bookmarks.length %></strong></span>
            </li>
          </ul>

          <div class="skills-section">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
              <h4 style="margin:0;">Declared Skills</h4>
              <a href="/onboarding?edit=1" style="font-size:11.5px; color:var(--link); text-decoration:none;">Customize</a>
            </div>
            <div class="skills-cloud">
              <% effectiveSkills.forEach(function(skill) {
                   const sName = typeof skill === 'string' ? skill : (skill.name || 'Code');
                   const sColor = skillDotColors[sName.toLowerCase()] || '#818CF8';
              %>
                <span class="skill-chip"><span class="skill-dot" style="background-color: <%= sColor %>;"></span><%= sName %></span>
              <% }); %>
            </div>
          </div>

          <!-- ======================= CONTRIBUTION STREAK WIDGET (MEMBER 3) ======================= -->
          <% if (locals.streak) { %>
            <div class="streak-sidebar-widget" id="sidebar-streak-card" aria-label="Contribution Streak">
              <div class="streak-widget-header">
                <div class="streak-flame-icon" aria-hidden="true">🔥</div>
                <div class="streak-header-info">
                  <div class="streak-count-title" id="streak-count-display"><%= streak.current_streak %> Day Streak</div>
                  <div class="streak-sub-title">Best: <%= streak.longest_streak %>d &bull; <%= streak.total_active_days %> total days</div>
                </div>
                <% if (streak.activeToday) { %>
                  <span class="streak-badge-active" title="Contribution recorded today">Active</span>
                <% } else { %>
                  <span class="streak-badge-pending" title="Make an action today to keep your streak">Pending</span>
                <% } %>
              </div>

              <!-- 7-Day Mini Dots Timeline -->
              <div class="streak-dots-row">
                <% (streak.recentWeek || []).forEach(function(day) { %>
                  <div class="streak-dot-col <%= day.isToday ? 'is-today' : '' %>" title="<%= day.date %>: <%= day.active ? 'Active' : 'No activity' %>">
                    <div class="streak-dot <%= day.active ? 'dot-active' : 'dot-inactive' %>">
                      <% if (day.active) { %>&#10003;<% } %>
                    </div>
                    <span class="streak-dot-label"><%= day.dayName %></span>
                  </div>
                <% }); %>
              </div>

              <div class="streak-motivation">
                <%= streak.statusMessage %>
              </div>

              <div style="display:flex; gap:6px; margin-top:8px;">
                <a href="/streak" class="btn btn-sm" style="flex:1; text-align:center; font-size:11px; padding:6px 4px;">
                  🔥 Streaks &rarr;
                </a>
                <a href="/badges" class="btn btn-sm" style="flex:1; text-align:center; font-size:11px; padding:6px 4px;">
                  🏆 Badges (<%= locals.badgeStats ? badgeStats.unlockedCount : 0 %>) &rarr;
                </a>
              </div>
            </div>
          <% } %>
        </aside>

        <!-- ======================= MAIN CONTENT ======================= -->
        <section class="dash-content-area">
          <!-- METRIC CARDS DERIVED FROM REAL DATA -->
          <div class="metrics-row" aria-label="Live Developer Statistics">
            <div class="metric-card">
              <div class="metric-title">Public Repositories</div>
              <div class="metric-val"><%= profile.public_repos %></div>
              <div class="metric-sub">Sourced from GitHub profile</div>
            </div>
            <div class="metric-card">
              <div class="metric-title">Persistent Bookmarks</div>
              <div class="metric-val" id="stats-bookmark-count"><%= bookmarks.length %></div>
              <div class="metric-sub">Stored in SQLite database</div>
            </div>
            <div class="metric-card">
              <div class="metric-title">Discovered Issues</div>
              <div class="metric-val"><%= totalIssuesCount.toLocaleString() %></div>
              <div class="metric-sub">Matching active query</div>
            </div>
            <div class="metric-card">
              <div class="metric-title">Contribution Readiness</div>
              <div class="metric-val" style="color:var(--accent-text);">
                <%= locals.readinessScore ? readinessScore.score : 75 %>%
              </div>
              <div class="metric-sub"><%= locals.readinessScore ? readinessScore.readinessLevel : 'Rule-based score' %></div>
            </div>
          </div>

          <!-- ======================= MODULE 1: CONTRIBUTION READINESS SCORE ======================= -->
          <% if (locals.readinessScore) {
               const rs = readinessScore;
               const rmProg = locals.roadmapProgress || { completedCount: 0, totalStages: 14, percentage: 0 };
          %>
            <div class="dash-card" id="contribution-readiness-card" aria-label="Contribution Readiness Score">
              <div class="dash-card-header">
                <h3 class="dash-card-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
                  Contribution Readiness Score &amp; Skill Alignment
                </h3>
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                  <a href="/roadmap" class="btn btn-sm">
                    14-Stage Roadmap (<%= rmProg.completedCount %>/<%= rmProg.totalStages %>)
                  </a>
                  <a href="/onboarding?edit=1" class="btn btn-sm btn-primary">
                    Update Skills &amp; Level
                  </a>
                </div>
              </div>

              <div class="dash-card-body">
                <div class="readiness-grid">
                  <!-- Left: Visual Score Box -->
                  <div class="readiness-score-box">
                    <div style="font-size:11.5px; text-transform:uppercase; letter-spacing:0.05em; color:var(--muted); font-weight:700; margin-bottom:6px;">
                      Readiness Score
                    </div>
                    <div class="readiness-score-num" id="readiness-score-value"><%= rs.score %><span style="font-size:18px; color:var(--muted);">/100</span></div>
                    <div class="readiness-tier-badge <%= rs.badgeClass || 'medium' %>" id="readiness-level-badge">
                      <%= rs.readinessLevel %>
                    </div>
                    <div class="readiness-bar-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= rs.score %>">
                      <div class="readiness-bar-fill" style="width: <%= rs.score %>%;"></div>
                    </div>
                    <div style="margin-top:10px; font-size:12px; color:var(--muted);">
                      Experience Tier: <strong style="color:var(--text);"><%= rs.experienceLevel %></strong>
                    </div>
                  </div>

                  <!-- Right: 4-Factor Breakdown, Matched/Missing Skills & Actionable Suggestions -->
                  <div>
                    <div class="readiness-factors">
                      <% Object.keys(rs.breakdown || {}).forEach(function(bKey) {
                           const factor = rs.breakdown[bKey];
                      %>
                        <div class="readiness-factor-card">
                          <div class="readiness-factor-top">
                            <span><%= factor.label %></span>
                            <span style="color:var(--accent-text);"><%= factor.score %> / <%= factor.maxScore %> pts</span>
                          </div>
                          <div class="readiness-bar-track" style="height:5px; margin-bottom:6px;">
                            <div class="readiness-bar-fill" style="width: <%= factor.percentage %>%;"></div>
                          </div>
                          <div style="font-size:11.5px; color:var(--muted); line-height:1.4;"><%= factor.explanation %></div>
                        </div>
                      <% }); %>
                    </div>

                    <!-- Matched & Missing Skills -->
                    <div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:12px; font-size:12.5px;">
                      <div>
                        <strong style="color:var(--text); display:inline-block; margin-right:6px;">Matched Skills:</strong>
                        <% if (rs.matchedSkills && rs.matchedSkills.length > 0) { %>
                          <% rs.matchedSkills.forEach(function(ms) { %>
                            <span class="readiness-skill-pill matched">&#10003; <%= ms %></span>
                          <% }); %>
                        <% } else if (rs.declaredSkills && rs.declaredSkills.length > 0) { %>
                          <% rs.declaredSkills.slice(0, 4).forEach(function(ds) { %>
                            <span class="readiness-skill-pill matched"><%= ds %> (Declared)</span>
                          <% }); %>
                        <% } else { %>
                          <span style="color:var(--muted);">None declared yet</span>
                        <% } %>
                      </div>

                      <div>
                        <strong style="color:var(--text); display:inline-block; margin-right:6px;">Missing / Unmatched Issue Skills:</strong>
                        <% if (rs.missingSkills && rs.missingSkills.length > 0) { %>
                          <% rs.missingSkills.forEach(function(mis) { %>
                            <span class="readiness-skill-pill missing">+ <%= mis %></span>
                          <% }); %>
                        <% } else { %>
                          <span style="color:#4ade80;">No missing skill gaps detected for current issues</span>
                        <% } %>
                      </div>
                    </div>

                    <!-- Actionable Suggestions -->
                    <div style="background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:10px 14px; font-size:12.5px;">
                      <strong style="color:var(--text); display:block; margin-bottom:4px;">Suggestions to Improve Readiness:</strong>
                      <ul style="margin:0; padding-left:18px; color:var(--muted); line-height:1.55;">
                        <% (rs.suggestions || []).forEach(function(sug) { %>
                          <li><%= sug %></li>
                        <% }); %>
                      </ul>
                      <div style="margin-top:6px; font-size:11px; color:var(--muted); border-top:1px solid var(--border); padding-top:6px;">
                        <%= rs.formulaExplanation %>
                        <div style="margin-top:4px; color:var(--text-muted, #94a3b8);">
                          <strong>Note:</strong> <%= rs.assessmentDisclaimer || 'Estimated readiness assessment based on rule-based profile and issue metadata — not a guarantee of contribution acceptance.' %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <!-- REAL ISSUE DISCOVERY & FILTERING -->
          <div class="dash-card">
            <div class="dash-card-header">
              <div class="tab-group" role="tablist">
                <a href="/dashboard?username=<%= encodeURIComponent(targetUsername) %>&label=all&language=<%= encodeURIComponent(activeLanguage) %>" class="tab-btn <%= activeLabel === 'all' ? 'active' : '' %>">
                  Recommended For You
                </a>
                <a href="/dashboard?username=<%= encodeURIComponent(targetUsername) %>&label=good-first-issue&language=<%= encodeURIComponent(activeLanguage) %>" class="tab-btn <%= activeLabel === 'good-first-issue' ? 'active' : '' %>">
                  Good First Issues
                </a>
                <a href="/dashboard?username=<%= encodeURIComponent(targetUsername) %>&label=help-wanted&language=<%= encodeURIComponent(activeLanguage) %>" class="tab-btn <%= activeLabel === 'help-wanted' ? 'active' : '' %>">
                  Help Wanted
                </a>
                <button type="button" class="tab-btn" id="view-bookmarks-tab">
                  Saved Bookmarks (<span id="tab-bookmark-count"><%= bookmarks.length %></span>)
                </button>
              </div>
            </div>

            <!-- SEARCH AND FILTER CONTROLS -->
            <form action="/dashboard" method="GET" class="filter-bar" id="issue-search-form">
              <input type="hidden" name="username" value="<%= targetUsername %>">
              <input type="hidden" name="label" value="<%= activeLabel %>">

              <div class="filter-search">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="7" r="4.8"/><path d="M10.6 10.6L14 14"/></svg>
                <input name="q" value="<%= activeQuery %>" type="search" placeholder="Search open-source issues by keyword or topic..." aria-label="Search open-source issues" autocomplete="off">
              </div>

              <div class="filter-selects">
                <select name="language" class="filter-select" aria-label="Filter issues by programming language" onchange="this.form.submit()">
                  <option value="all" <%= activeLanguage === 'all' ? 'selected' : '' %>>Language: All</option>
                  <option value="javascript" <%= activeLanguage === 'javascript' ? 'selected' : '' %>>JavaScript</option>
                  <option value="typescript" <%= activeLanguage === 'typescript' ? 'selected' : '' %>>TypeScript</option>
                  <option value="python" <%= activeLanguage === 'python' ? 'selected' : '' %>>Python</option>
                  <option value="rust" <%= activeLanguage === 'rust' ? 'selected' : '' %>>Rust</option>
                  <option value="go" <%= activeLanguage === 'go' ? 'selected' : '' %>>Go</option>
                </select>

                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
              </div>
            </form>

            <!-- ISSUES LIST -->
            <div id="issues-list-container">
              <% if (issues.length === 0) { %>
                <div class="state-box">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <h3>No matching open issues found</h3>
                  <p>Try clearing your keyword query or expanding the language filter to discover more open-source opportunities.</p>
                  <a href="/dashboard?username=<%= encodeURIComponent(targetUsername) %>" class="btn btn-sm">Reset Search</a>
                </div>
              <% } else { %>
                <ul class="issue-items">
                  <% issues.forEach(function(issue) { %>
                    <li class="issue-row">
                      <div class="issue-main">
                        <div class="issue-header-line">
                          <a href="<%= issue.repoUrl %>" target="_blank" rel="noopener noreferrer" class="issue-repo-link">
                            <%= issue.repoName %>
                          </a>
                          <span class="issue-number">#<%= issue.number %></span>
                        </div>

                        <a href="<%= issue.htmlUrl %>" target="_blank" rel="noopener noreferrer" class="issue-title-link">
                          <%= issue.title %>
                        </a>

                        <div class="issue-labels">
                          <% issue.labels.forEach(function(lbl) { %>
                            <span class="issue-label <%= lbl.isGfi ? 'gfi' : lbl.isHw ? 'hw' : 'tag' %>" style="border-color: <%= lbl.color %>33;">
                              <%= lbl.name %>
                            </span>
                          <% }); %>
                        </div>

                        <div class="issue-meta-info">
                          <span>Difficulty: <strong><%= issue.difficulty %></strong></span>
                          <span>&bull;</span>
                          <span><%= issue.commentsCount %> comments</span>
                          <span>&bull;</span>
                          <span>Opened <%= issue.createdAt %> by <%= issue.author %></span>
                        </div>
                      </div>

                      <div class="issue-side">
                        <div class="compat-badge <%= issue.compatibilityScore >= 85 ? 'high' : 'medium' %>"
                             title="Skill Overlap: <%= issue.compatibilityBreakdown.skillOverlap %>%, Alignment: <%= issue.compatibilityBreakdown.difficultyAlignment %>%, Community Support: <%= issue.compatibilityBreakdown.mentorSupport %>%">
                          <%= issue.compatibilityScore %>% Match
                        </div>
                        <% if (issue.readiness) { %>
                          <div class="compat-badge <%= issue.readiness.score >= 75 ? 'high' : 'medium' %>"
                               style="margin-top:4px; font-size:11px;"
                               title="<%= issue.readiness.readinessLevel %> — <%= issue.readiness.assessmentDisclaimer || 'Estimated readiness assessment' %>">
                            Readiness: <%= issue.readiness.score %>%
                          </div>
                        <% } %>

                        <div class="issue-actions">
                          <button class="bookmark-btn <%= issue.isBookmarked ? 'active' : '' %>"
                                  type="button"
                                  data-issue-id="<%= issue.id %>"
                                  data-number="<%= issue.number %>"
                                  data-repo="<%= issue.repoName %>"
                                  data-title="<%= issue.title %>"
                                  data-html-url="<%= issue.htmlUrl %>"
                                  data-difficulty="<%= issue.difficulty %>"
                                  data-comments="<%= issue.commentsCount %>"
                                  aria-label="Bookmark issue"
                                  aria-pressed="<%= issue.isBookmarked ? 'true' : 'false' %>"
                                  title="Toggle bookmark (persisted in SQLite)">
                            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                          </button>

                          <a href="<%= issue.htmlUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
                            View on GitHub &rarr;
                          </a>
                        </div>
                      </div>
                    </li>
                  <% }); %>
                </ul>

                <!-- PAGINATION CONTROLS -->
                <% if (totalPages > 1) { %>
                  <div style="display:flex; align-items:center; justify-content:space-between; padding:16px 24px; border-top:1px solid var(--border); font-size:13px; color:var(--muted);">
                    <div>
                      Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (<%= totalIssuesCount.toLocaleString() %> issues)
                    </div>
                    <div style="display:flex; gap:8px;">
                      <% if (currentPage > 1) { %>
                        <a href="/dashboard?username=<%= encodeURIComponent(targetUsername) %>&label=<%= encodeURIComponent(activeLabel) %>&language=<%= encodeURIComponent(activeLanguage) %>&q=<%= encodeURIComponent(activeQuery) %>&page=<%= currentPage - 1 %>" class="btn btn-sm">
                          &larr; Previous
                        </a>
                      <% } %>
                      <% if (currentPage < totalPages) { %>
                        <a href="/dashboard?username=<%= encodeURIComponent(targetUsername) %>&label=<%= encodeURIComponent(activeLabel) %>&language=<%= encodeURIComponent(activeLanguage) %>&q=<%= encodeURIComponent(activeQuery) %>&page=<%= currentPage + 1 %>" class="btn btn-sm">
                          Next &rarr;
                        </a>
                      <% } %>
                    </div>
                  </div>
                <% } %>
              <% } %>
            </div>

            <!-- BOOKMARKS MODAL / CONTAINER (Persistent from SQLite) -->
            <div id="bookmarks-view-container" style="display: none; padding: 24px;">
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
                <h3 style="margin:0; font-size:16px;">Your Persistent Database Bookmarks (<span id="saved-bookmarks-heading-count"><%= bookmarks.length %></span>)</h3>
                <button type="button" class="btn btn-sm" id="close-bookmarks-view">Back to Discovery</button>
              </div>

              <% if (bookmarks.length === 0) { %>
                <div class="state-box">
                  <p>No issues bookmarked yet. Click the bookmark ribbon on any discovered issue to store it in your database.</p>
                </div>
              <% } else { %>
                <ul class="issue-items">
                  <% bookmarks.forEach(function(b) { %>
                    <li class="issue-row">
                      <div class="issue-main">
                        <div class="issue-header-line">
                          <span class="issue-repo-link"><%= b.repo_name %></span>
                          <span class="issue-number">#<%= b.issue_number %></span>
                        </div>
                        <a href="<%= b.html_url %>" target="_blank" rel="noopener noreferrer" class="issue-title-link">
                          <%= b.title %>
                        </a>
                        <div class="issue-meta-info">
                          <span>Difficulty: <strong><%= b.difficulty %></strong></span>
                          <span>&bull;</span>
                          <span>Saved to SQLite: <%= new Date(b.created_at).toLocaleDateString() %></span>
                        </div>
                      </div>
                      <div class="issue-side" style="display:flex; gap:8px; align-items:center;">
                        <button type="button" class="btn btn-sm remove-saved-bookmark-btn" data-html-url="<%= b.html_url %>" title="Remove bookmark from SQLite">
                          Remove
                        </button>
                        <a href="<%= b.html_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
                          Open GitHub &rarr;
                        </a>
                      </div>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>

          <!-- PERSONALIZED REPOSITORY RECOMMENDATIONS -->
<div class="dash-card">
  <div class="dash-card-header">
    <h3 class="dash-card-title">Recommended Projects for You</h3>
  </div>

  <div class="dash-card-body">
    <% if (!userSkills || userSkills.length === 0) { %>
      <p style="color:var(--muted);">
        Add your skills to your profile to receive personalized recommendations.
      </p>
    <% } else if (!recommendedRepositories || recommendedRepositories.length === 0) { %>
      <p style="color:var(--muted);">
        No matching repositories found. Try updating your skills.
      </p>
    <% } else { %>
      <div class="repo-grid">
        <% recommendedRepositories.forEach(function(repo) { %>
          <article class="repo-card">
            <div class="repo-card-head">
              <a href="<%= repo.htmlUrl %>" target="_blank"
                 rel="noopener noreferrer" class="repo-card-title">
                <%= repo.fullName %>
              </a>
              <span><%= repo.compatibilityScore %>% Match</span>
            </div>

            <p class="repo-card-desc">
              <%= repo.description || 'No description available.' %>
            </p>

            <div style="font-size:12px;color:var(--muted);">
              Language: <%= repo.language || 'Not specified' %>
            </div>

            <div style="margin-top:8px;font-size:12px;">
              <strong>Matched Skills:</strong>
              <%= (repo.matchedSkills || []).join(', ') || 'None' %>
            </div>

            <div class="repo-card-foot">
              <span>Stars: <%= repo.stars %></span>
              <a href="<%= repo.htmlUrl %>" target="_blank"
                 rel="noopener noreferrer" class="btn btn-sm btn-outline">
                Explore Project &rarr;
              </a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
<!-- END PERSONALIZED RECOMMENDATIONS -->

          <div class="dash-card">
            <div class="dash-card-header">
              <h3 class="dash-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                Public Repositories for @<%= targetUsername %>
              </h3>
            </div>
            <div class="dash-card-body">
              <% if (repos.length === 0) { %>
                <p style="color:var(--muted); font-size:13.5px;">No public repositories available for this account.</p>
              <% } else { %>
                <div class="repo-grid">
                  <% repos.forEach(function(r) { %>
                    <article class="repo-card">
                      <div class="repo-card-head">
                        <a href="<%= r.htmlUrl %>" target="_blank" rel="noopener noreferrer" class="repo-card-title">
                          <%= r.name %>
                        </a>
                        <span>★ <%= r.stars %></span>
                      </div>
                      <p class="repo-card-desc"><%= r.description %></p>
                      <% if (r.health) { %>
                        <div style="font-size:11.5px; color:var(--muted); display:flex; align-items:center; justify-content:space-between; background:var(--bg); padding:5px 9px; border-radius:6px; border:1px solid var(--border);">
                          <span>Repo Health: <strong style="color:var(--text);"><%= r.health.score %>/100</strong></span>
                          <span style="color:var(--accent-text); font-weight:600;"><%= r.health.statusLabel %></span>
                        </div>
                      <% } %>
                      <div class="repo-card-foot" style="display:flex; justify-content:space-between; align-items:center;">
                        <span><%= r.language %></span>
                        <a href="<%= r.htmlUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">
                          View Repo &rarr;
                        </a>
                      </div>
                    </article>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>

          <!-- REAL RECENT ACTIVITY -->
          <div class="dash-card">
            <div class="dash-card-header">
              <h3 class="dash-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Recent Public GitHub Activity
              </h3>
            </div>
            <div class="dash-card-body">
              <% if (events.length === 0) { %>
                <p style="color:var(--muted); font-size:13.5px;">No public activity records found in the recent event stream.</p>
              <% } else { %>
                <ul class="activity-list">
                  <% events.forEach(function(ev) { %>
                    <li class="activity-item">
               <!-- REAL GITHUB REPOSITORIES -->       <div class="activity-icon <%= ev.type === 'pr' ? 'merged' : ev.type === 'push' ? 'opened' : 'comment' %>">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                      </div>
                      <div class="activity-content">
                        <div class="activity-title"><%= ev.title %></div>
                        <div class="activity-meta">
                          <a href="<%= ev.repoUrl %>" target="_blank" rel="noopener noreferrer" style="color:var(--link);"><%= ev.repo %></a> &bull; <%= ev.timestamp %>
                        </div>
                      </div>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>

          <!-- QUICK ACTION: MY PORTFOLIO -->
          <div class="dash-card">
            <div class="dash-card-header">
              <h3 class="dash-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="15" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                My Portfolio
              </h3>
              <a href="/portfolio" class="btn btn-sm btn-primary">Open Portfolio &rarr;</a>
            </div>
            <div class="dash-card-body">
              <p style="color:var(--muted); font-size:13.5px; margin:0;">View and edit your shareable developer portfolio — showcase your repos, skills, and open-source contributions.</p>
            </div>
          </div>

          <!-- QUICK ACTION: SKILL TREE -->
          <div class="dash-card">
            <div class="dash-card-header">
              <h3 class="dash-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="3"/><path d="M12 8v8M8 20a4 4 0 0 1 8 0"/><circle cx="8" cy="18" r="2"/><circle cx="16" cy="18" r="2"/></svg>
                Skill Tree
              </h3>
              <a href="/skill-tree" class="btn btn-sm btn-primary">Open Skill Tree &rarr;</a>
            </div>
            <div class="dash-card-body">
              <p style="color:var(--muted); font-size:13.5px; margin:0;">Track your technical progression and unlock achievements as you level up across frontend, backend, DevOps, and open-source tracks.</p>
            </div>
          </div>

        </section>
      </div>

    </div>
  </main>

  <!-- ======================= FOOTER ======================= -->
  <%- include('partials/footer') %>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3.2 3L13 4.5"/></svg>
    <span id="toast-msg"></span>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
