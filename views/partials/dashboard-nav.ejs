<%
  const activePage = locals.activePage || '';
  const siteName = locals.siteName || 'DevNexus';
%>
<header class="nav" id="nav">
  <div class="container nav-inner">
    <a class="logo" href="/" aria-label="<%= siteName %> home">
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <circle cx="9" cy="7" r="3.2"/><circle cx="9" cy="25" r="3.2"/><circle cx="23" cy="13" r="3.2"/>
        <path d="M9 10.2v11.6M23 16.2c0 5-5 5-11 7.2"/>
      </svg>
      <%= siteName %>
    </a>

    <nav class="nav-links" aria-label="Dashboard navigation">
      <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/" title="Home">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <a class="nav-link <%= activePage === 'projects' ? 'active' : '' %>" href="/projects" title="Explore Projects">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-9z"/><path d="M6 2v12M2 6h12"/></svg>
        Projects
      </a>
      <a class="nav-link <%= activePage === 'guide' ? 'active' : '' %>" href="/learn" title="Contribution Guide">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 3h5a3 3 0 0 1 3 3v8a3 3 0 0 0-3-3H2z"/><path d="M14 3h-5a3 3 0 0 0-3 3v8a3 3 0 0 1 3-3h5z"/></svg>
        Guide
      </a>
      <a class="nav-link <%= activePage === 'leaderboard' ? 'active' : '' %>" href="/leaderboard" title="Community Leaderboard">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 13V7h4v6M2 13V9h4v4M10 13V4h4v9H2z"/></svg>
        Leaderboard
      </a>
      <a class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>" href="/dashboard" title="Developer Dashboard">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
        Dashboard
      </a>
      <a class="nav-link <%= activePage === 'portfolio' ? 'active' : '' %>" href="/portfolio" title="Developer Portfolio">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="4" width="12" height="10" rx="1"/><path d="M5 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/></svg>
        Portfolio
      </a>
      <a class="nav-link <%= activePage === 'skill-tree' ? 'active' : '' %>" href="/skill-tree" title="Interactive Skill Tree">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8" cy="4" r="2"/><path d="M8 6v4M5 14a3 3 0 0 1 6 0"/><circle cx="5" cy="12" r="1.5"/><circle cx="11" cy="12" r="1.5"/></svg>
        Skill Tree
      </a>
      <a class="nav-link <%= activePage === 'admin' ? 'active' : '' %>" href="/admin" title="Admin Dashboard">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>
        Admin
      </a>
    </nav>

    <div class="nav-right">
      <form class="search" action="/search" method="GET" style="margin: 0;" role="search">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="7" cy="7" r="4.8"/><path d="M10.6 10.6L14 14"/></svg>
        <input id="nav-search" name="q" type="search" placeholder="Search projects..." aria-label="Search repositories, issues, or topics" autocomplete="off">
        <span class="kbd" aria-hidden="true">/</span>
      </form>

      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>

      <% if (locals.isAdmin) { %>
        <span class="admin-badge">
          <span class="status-dot online"></span> Admin Session
        </span>
        <a href="/admin/logout" class="btn btn-sm" title="End Admin Session">Sign Out</a>
      <% } else if (locals.user) { %>
        <a href="/profile" class="profile-pill" title="Edit Profile &amp; Skills">
          <img class="avatar" src="<%= user.avatar_url || 'https://avatars.githubusercontent.com/u/9919?v=4' %>" alt="<%= user.username %> avatar" width="26" height="26">
          <span class="profile-name">@<%= user.username %></span>
        </a>
        <a href="/auth/logout" class="btn btn-sm" title="Sign Out">Sign Out</a>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-primary">Sign In</a>
      <% } %>

      <button class="icon-btn burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-panel">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-panel">
    <div class="container inner">
      <a class="m-link <%= activePage === 'home' ? 'active' : '' %>" href="/">Landing Page</a>
      <a class="m-link <%= activePage === 'projects' ? 'active' : '' %>" href="/projects">Explore Projects</a>
      <a class="m-link <%= activePage === 'guide' ? 'active' : '' %>" href="/learn">Contribution Guide</a>
      <a class="m-link <%= activePage === 'leaderboard' ? 'active' : '' %>" href="/leaderboard">Leaderboard</a>
      <a class="m-link <%= activePage === 'dashboard' ? 'active' : '' %>" href="/dashboard">Developer Dashboard</a>
      <a class="m-link <%= activePage === 'portfolio' ? 'active' : '' %>" href="/portfolio">Portfolio</a>
      <a class="m-link <%= activePage === 'skill-tree' ? 'active' : '' %>" href="/skill-tree">Skill Tree</a>
      <a class="m-link <%= activePage === 'admin' ? 'active' : '' %>" href="/admin">Admin Dashboard</a>
      <div class="m-actions">
        <% if (locals.isAdmin) { %>
          <a class="btn" href="/admin/logout">Exit Admin Session</a>
        <% } else if (locals.user) { %>
          <a class="btn" href="/profile">Edit Profile</a>
          <a class="btn" href="/auth/logout">Sign Out</a>
        <% } else { %>
          <a class="btn btn-primary" href="/login">Sign In</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
<script>
  (function () {
    if (window.__devnexusNavInit) return;
    window.__devnexusNavInit = true;

    var themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', function () {
        var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        var nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', nextTheme);
        try { localStorage.setItem('theme', nextTheme); } catch (e) {}
      });
    }

    var burger = document.getElementById('burger');
    var mobilePanel = document.getElementById('mobile-panel');
    if (burger && mobilePanel) {
      burger.addEventListener('click', function () {
        var isOpen = mobilePanel.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(isOpen));
      });
    }

    document.addEventListener('keydown', function (e) {
      var tag = (document.activeElement || {}).tagName;
      if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
        var s = document.getElementById('nav-search') || document.querySelector('input[name="q"]');
        if (s) { e.preventDefault(); s.focus(); }
      }
    });
  })();
</script>
